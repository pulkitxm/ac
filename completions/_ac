#compdef ac
# zsh completion for `ac`.
# Install: add the completions/ directory to $fpath before `compinit`.

_ac_projects() {
  local -a dirs
  dirs=("${XDG_CONFIG_HOME:-$HOME/.config}/ac/projects" "${AC_HOME:-$HOME/scripts/ac}/projects")
  local d f
  for d in $dirs; do
    [[ -d $d ]] || continue
    for f in $d/*.json(N); do
      print -r -- ${${f:t}:r}
    done
  done | sort -u
}

_ac_services() {
  local proj=$1 d f
  for d in "${XDG_CONFIG_HOME:-$HOME/.config}/ac/projects" "${AC_HOME:-$HOME/scripts/ac}/projects"; do
    f="$d/$proj.json"
    if [[ -f $f ]]; then
      jq -r '.services[].name' "$f" 2>/dev/null
      return
    fi
  done
}

_ac() {
  local -a commands actions
  commands=(
    'ls:list available projects'
    'projects:list available projects'
    'status:daemon and project status'
    'daemon:manage the container daemon'
    'config:show resolved config'
    'help:show usage'
    'version:show version'
  )
  actions=(
    'start:start every service'
    'stop:stop and remove every service'
    'restart:stop then start'
    'status:per-service state'
    'ps:per-service state'
    'logs:tail a service log'
    'exec:run a command in a service'
    'ip:print container IPs'
  )

  if (( CURRENT == 2 )); then
    local -a projs
    projs=(${(f)"$(_ac_projects)"})
    _describe -t projects 'project' projs
    _describe -t commands 'command' commands
    return
  fi

  local first=${words[2]}

  if [[ $first == daemon ]]; then
    (( CURRENT == 3 )) && _values 'daemon action' 'status[show daemon state]' 'stop[stop if ac owns it]'
    return
  fi

  # Reserved words take no further completion.
  case $first in
    ls|projects|status|config|help|version) return ;;
  esac

  if (( CURRENT == 3 )); then
    _describe -t actions 'action' actions
    return
  fi

  # `ac <project> logs|exec|ip <service>`
  if (( CURRENT == 4 )); then
    case ${words[3]} in
      logs|exec|ip)
        local -a svcs
        svcs=(${(f)"$(_ac_services $first)"})
        _describe -t services 'service' svcs
        ;;
    esac
  fi
}

_ac "$@"
