#!/usr/bin/env bash
# ac - a tiny project runner for Apple `container`.
#
#   ac shop start      bring a project's containers up
#   ac shop stop       tear them down (and the daemon, if ac started it)
#
# See README.md for the daemon ownership rules.

set -uo pipefail

# Resolve through symlinks: install.sh links this into ~/.local/bin, so
# BASH_SOURCE points at the link, not the repo. macOS has no portable
# `readlink -f`, hence the manual walk.
_ac_script_dir() {
  local src="$1" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P "$(dirname "$src")" && pwd
}

AC_HOME="$(cd "$(_ac_script_dir "${BASH_SOURCE[0]}")/.." && pwd)"
export AC_HOME

. "$AC_HOME/lib/common.sh"
. "$AC_HOME/lib/daemon.sh"
. "$AC_HOME/lib/supervisor.sh"
. "$AC_HOME/lib/project.sh"
. "$AC_HOME/lib/build.sh"

require jq
require container

# Only request a TTY when we actually have one, otherwise the runtime rejects
# the exec with ENODEV (e.g. in scripts and CI).
_tty_flags() {
  if [ -t 0 ] && [ -t 1 ]; then printf -- '-i -t'; else printf -- '-i'; fi
}

# Turn `svc:/path` into `<project>-<svc>:/path`; leave host paths untouched.
_cp_path() {
  local proj="$1" arg="$2"
  case "$arg" in
    */*:*|/*) printf '%s' "$arg"; return ;;   # looks like a host path
    *:*)
      local svc="${arg%%:*}" path="${arg#*:}"
      if proj_has_service "$proj" "$svc"; then
        printf '%s:%s' "$(svc_container_name "$proj" "$svc")" "$path"
        return
      fi
      ;;
  esac
  printf '%s' "$arg"
}

# Split arguments into flags (leading dash) and service names, so actions can
# accept both without flags tripping service validation.
_AC_FLAGS=(); _AC_SVCS=()
_split_args() {
  _AC_FLAGS=(); _AC_SVCS=()
  local a
  for a in "$@"; do
    case "$a" in
      -*) _AC_FLAGS+=("$a") ;;
      *)  _AC_SVCS+=("$a") ;;
    esac
  done
}

usage() {
  cat <<EOF
${C_BOLD}ac${C_RESET} - Apple Container project runner (v$AC_VERSION)

${C_BOLD}USAGE${C_RESET}
  ac <project> <action> [args]
  ac <command>

${C_BOLD}PROJECT ACTIONS${C_RESET}  (most take optional service names; default is all)
  start [svc...]        start services
  stop [svc...]         stop services, keeping them for a fast restart
  down [svc...]         stop AND remove containers (volumes/data survive)
  restart [svc...]      stop then start
  ls, ps, status        per-service state, IP and published ports
  logs [-f] [-n N] <svc>  show logs (-f follows, --boot for the boot log)
  exec <svc> <cmd...>   run a command inside a service
  sh, shell [svc]       interactive shell inside a service
  stats [svc...]        live resource usage
  inspect [svc...]      full container JSON
  kill [-s SIG] [svc..] send a signal (default KILL)
  rm [svc...]           force remove containers, leaving volumes
  cp <src> <dst>        copy files; use svc:/path for the container side
  pull [svc...]         pre-pull images
  images                images this project uses
  port [svc]            published port mappings
  ip [svc]              container IPs
  env <svc>             environment variables from the manifest
  build [name...]       build images; see BUILD FLAGS below
  login                 authenticate to the project's private registries
  config                the project manifest

${C_BOLD}BUILD FLAGS${C_RESET}  (each overrides the manifest)
  -P, --profile <name>  profile to build for (default: local)
  --root <path>         build from this tree (default: current git worktree)
  --platform <os/arch>  e.g. linux/amd64, linux/arm64
  --push / --no-push    override the profile's push setting
  --no-cache            ignore the layer cache
  --target <stage>      Dockerfile stage
  --builder-cpus <n>    resize the shared buildkit builder
  --builder-memory <m>  e.g. 8g
  --sequential          build one at a time instead of in parallel

${C_BOLD}COMMANDS${C_RESET}
  ls, projects          list available projects
  status                daemon + all project status
  daemon status         show daemon state and who owns it
  daemon stop           stop the daemon (only if ac started it)
  images                every image in the local store
  df                    disk usage for images, containers and volumes
  prune                 remove stopped containers and unused images
  config                show resolved config
  help, version

${C_BOLD}PROJECTS${C_RESET}
$(ac_project_names | sed 's/^/  /')

Projects are JSON files in $AC_HOME/projects
or $AC_CONFIG_DIR/projects (user overrides win).
EOF
}

cmd_global_status() {
  printf '%sdaemon%s  %s\n' "$C_BOLD" "$C_RESET" "$(daemon_status_line)"
  if supervisor_running; then
    printf '%ssupervisor%s  running (pid %s)\n' "$C_BOLD" "$C_RESET" "$(supervisor_pid)"
  else
    printf '%ssupervisor%s  not running\n' "$C_BOLD" "$C_RESET"
  fi
  echo
  local p
  ac_project_names | while IFS= read -r p; do
    [ -n "$p" ] || continue
    printf '%s%s%s - %s\n' "$C_BOLD" "$p" "$C_RESET" "$(proj_description "$p")"
    project_status "$p"
    echo
  done
}

main() {
  ac_config_init

  local first="${1:-help}"

  case "$first" in
    help|-h|--help)   usage; return 0 ;;
    version|-v|--version) echo "ac $AC_VERSION"; return 0 ;;
    ls|projects)      ac_project_names; return 0 ;;
    config)           cat "$AC_CONFIG_FILE"; return 0 ;;
    status)           cmd_global_status; return 0 ;;
    __supervise)      supervisor_loop; return 0 ;;
    images)           daemon_ensure; container image ls; return 0 ;;
    df)               daemon_ensure; container system df; return 0 ;;
    prune)
      daemon_ensure
      info "removing stopped containers"
      container prune 2>&1 | tail -3
      info "removing unused images"
      container image prune 2>&1 | tail -3
      supervisor_settle
      return 0
      ;;
    daemon)
      case "${2:-status}" in
        status) daemon_status_line ;;
        stop)   supervisor_stop; daemon_release ;;
        *)      die "unknown daemon action: ${2:-}" ;;
      esac
      return 0
      ;;
  esac

  # Everything else is <project> <action>.
  local proj="$first" action="${2:-status}"
  ac_project_file "$proj" >/dev/null || die "unknown project: $proj (try: ac ls)"
  shift 2 2>/dev/null || shift 1

  case "$action" in
    start)
      if [ "${1:-}" = "--recreate" ]; then AC_F_RECREATE=1; shift; fi
      project_start "$proj" "$@" ;;
    stop)     project_stop "$proj" "$@" ;;
    down)     project_down "$proj" "$@" ;;
    restart)  project_stop "$proj" "$@"; project_start "$proj" "$@" ;;
    ls|ps|status) project_status "$proj" ;;
    pull)     project_pull "$proj" "$@" ;;
    images)   project_images "$proj" ;;
    config)   proj_json "$proj" ;;
    login)    daemon_ensure; project_login "$proj" "${AC_PROFILE:-local}" ;;

    build)
      # CLI flags take precedence over profile and manifest values.
      local bargs=()
      while [ $# -gt 0 ]; do
        case "$1" in
          -P|--profile)     AC_PROFILE="$2"; shift 2 ;;
          --profile=*)      AC_PROFILE="${1#*=}"; shift ;;
          --root)           AC_F_ROOT="$2"; shift 2
                            [ -d "$AC_F_ROOT" ] || die "--root does not exist: $AC_F_ROOT" ;;
          --root=*)         AC_F_ROOT="${1#*=}"; shift
                            [ -d "$AC_F_ROOT" ] || die "--root does not exist: $AC_F_ROOT" ;;
          --platform)       AC_F_PLATFORM="$2"; shift 2 ;;
          --platform=*)     AC_F_PLATFORM="${1#*=}"; shift ;;
          --target)         AC_F_TARGET="$2"; shift 2 ;;
          --builder-cpus)   AC_F_BCPUS="$2"; shift 2 ;;
          --builder-memory) AC_F_BMEM="$2"; shift 2 ;;
          --push)           AC_F_PUSH="true"; shift ;;
          --no-push)        AC_F_PUSH="false"; shift ;;
          --no-cache)       AC_F_NOCACHE=1; shift ;;
          --sequential)     AC_F_SEQUENTIAL=1; shift ;;
          -*)               die "unknown build flag: $1" ;;
          *)                bargs+=("$1"); shift ;;
        esac
      done
      project_build "$proj" ${bargs[@]+"${bargs[@]}"}
      ;;

    logs)
      # Flags and the service name may appear in any order, so pick out the
      # first argument that names a service and pass the rest through.
      local lsvc="" lflags=() a
      for a in "$@"; do
        if [ -z "$lsvc" ] && proj_has_service "$proj" "$a"; then
          lsvc=$(proj_normalize_service "$proj" "$a")
        else
          lflags+=("$a")
        fi
      done
      if [ -z "$lsvc" ]; then
        # No service named: interleave every service, like docker compose.
        project_logs_all "$proj" ${lflags[@]+"${lflags[@]}"}
      else
        container logs ${lflags[@]+"${lflags[@]}"} "$(svc_container_name "$proj" "$lsvc")"
      fi
      ;;

    exec)
      [ $# -ge 2 ] || die "usage: ac $proj exec <service> <command...>"
      local svc; svc=$(proj_normalize_service "$proj" "$1"); shift
      container exec $(_tty_flags) "$(svc_container_name "$proj" "$svc")" "$@"
      ;;

    sh|shell)
      local ssvc; ssvc=$(proj_normalize_service "$proj" "${1:-$(proj_services "$proj" | head -1)}")
      container exec $(_tty_flags) "$(svc_container_name "$proj" "$ssvc")" \
        sh -c 'command -v bash >/dev/null && exec bash || exec sh'
      ;;

    stats)
      _split_args "$@"
      local names; names=$(proj_container_names "$proj" ${_AC_SVCS[@]+"${_AC_SVCS[@]}"}) || exit 1
      container stats ${_AC_FLAGS[@]+"${_AC_FLAGS[@]}"} $(printf '%s ' $names)
      ;;

    inspect)
      _split_args "$@"
      local names; names=$(proj_container_names "$proj" ${_AC_SVCS[@]+"${_AC_SVCS[@]}"}) || exit 1
      container inspect $(printf '%s ' $names)
      ;;

    kill)
      local sig="KILL"
      if [ "${1:-}" = "-s" ] || [ "${1:-}" = "--signal" ]; then sig="$2"; shift 2; fi
      local names; names=$(proj_container_names "$proj" "$@") || exit 1
      container kill --signal "$sig" $(printf '%s ' $names)
      ;;

    rm)
      local names; names=$(proj_container_names "$proj" "$@") || exit 1
      container rm --force $(printf '%s ' $names)
      supervisor_settle
      ;;

    cp)
      # Rewrite `svc:/path` into `<project>-<svc>:/path` on either side.
      [ $# -eq 2 ] || die "usage: ac $proj cp <src> <dst>   (use svc:/path for the container)"
      container cp "$(_cp_path "$proj" "$1")" "$(_cp_path "$proj" "$2")"
      ;;

    port)
      local s
      proj_target_services "$proj" "$@" | while IFS= read -r s; do
        [ -n "$s" ] || continue
        printf '%-14s %s\n' "$s" \
          "$(proj_service_json "$proj" "$s" | jq -r '(.ports // []) | join(", ")')"
      done
      ;;

    env)
      [ $# -ge 1 ] || die "usage: ac $proj env <service>"
      proj_service_json "$proj" "$(proj_normalize_service "$proj" "$1")" | jq -r '(.env // {}) | to_entries[] | "\(.key)=\(.value)"'
      ;;

    ip)
      if [ $# -ge 1 ]; then
        container_ip "$(svc_container_name "$proj" "$(proj_normalize_service "$proj" "$1")")"
      else
        local s
        proj_services "$proj" | while IFS= read -r s; do
          [ -n "$s" ] || continue
          printf '%-14s %s\n' "$s" "$(container_ip "$(svc_container_name "$proj" "$s")")"
        done
      fi
      ;;

    *) die "unknown action: $action (try: ac help)" ;;
  esac
}

main "$@"
